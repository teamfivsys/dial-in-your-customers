# Server-only Hostinger Node.js configuration. Set database/payment/SMTP secrets in the server runtime, never VITE_ variables.
KDIAL_MYSQL_HOST=
KDIAL_MYSQL_PORT=3306
KDIAL_MYSQL_USER=
KDIAL_MYSQL_PASSWORD=
KDIAL_MYSQL_DATABASE=
# Use true for remote MySQL; Hostinger documents 127.0.0.1 for its in-host DB.
# Set false only for that literal loopback host if following Hostinger's local connection guide.
KDIAL_MYSQL_TLS=true
# Exact public HTTPS origin used by same-origin admin/CSRF checks.
KDIAL_APP_ORIGIN=https://kdial.in

# Build-time, non-secret mode selector for same-origin MySQL directory/admin/intake/payment APIs.
VITE_DIRECTORY_API_MODE=hostinger-mysql
# Keep the legacy browser backend disabled in the MySQL build.
VITE_DIRECTORY_BACKEND_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DIRECTORY_DEMO=false

# Public site key is non-secret and can be included in the web build; the secret stays server-only.
VITE_TURNSTILE_SITE_KEY=
KDIAL_TURNSTILE_SECRET=
# Use a random high-entropy secret; public submission/report protection fails closed without it.
KDIAL_SUBMISSION_RATE_SECRET=

# Password recovery is unavailable unless SMTP is configured.
KDIAL_SMTP_HOST=
KDIAL_SMTP_PORT=587
KDIAL_SMTP_USER=
KDIAL_SMTP_PASSWORD=
KDIAL_SMTP_FROM=

# Payment preview remains unavailable until the verified business destination is configured.
KDIAL_UPI_PAYEE=
KDIAL_UPI_ID=
KDIAL_UPI_QR_BASE64=

# Hostinger sets PORT; set HOST only when needed for local/server-specific binding.
# HOST=0.0.0.0
# PORT=3000
